rules_version = '2';

/**
 * FIREBASE STORAGE SECURITY RULES — Aurelio Hotels
 * Paste this into Firebase Console → Storage → Rules.
 *
 * Layout: room-images/{roomId}/{fileName}
 * Room photos are public to read (they're shown on the public site) but
 * only an authenticated admin (checked against their Firestore user doc)
 * may upload, replace, or delete them.
 */
service firebase.storage {
  match /b/{bucket}/o {

    match /room-images/{roomId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

/**
 * NOTE: The firestore.get() cross-service check above requires the
 * "Storage for Firebase" rules engine that supports Firestore lookups
 * (enabled by default in current Firebase projects). If your project
 * predates this feature, replace the admin check with a custom auth
 * claim instead:
 *
 *   allow write: if request.auth != null && request.auth.token.admin == true && ...
 *
 * and set that claim from a trusted server/Cloud Function — see the
 * README's "Promoting a user to admin" section for the console-based
 * alternative that doesn't require custom claims at all.
 */
